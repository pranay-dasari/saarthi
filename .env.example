# Supabase — copy from Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Gemini AI (optional — used for future AI features)
GEMINI_API_KEY=<your-gemini-key>
GEMINI_MODEL=gemini-2.5-flash

# Text-to-speech (set to "false" to disable app-wide TTS)
ENABLE_TTS=true
